<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>Flare.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Flare</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>io.github.itsmangooo.flare</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- Production builds target physical Android devices; pass -r android-x64 for an x64 emulator build. -->
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(FLARE_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningStorePass>$(FLARE_ANDROID_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>$(FLARE_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(FLARE_ANDROID_KEY_PASSWORD)</AndroidSigningKeyPass>
		<FlareAndroidApkFileName>Flare-v$(ApplicationDisplayVersion)-$(RuntimeIdentifier).apk</FlareAndroidApkFileName>
	</PropertyGroup>

	<Target Name="ValidateFlareAndroidReleaseSigning"
			BeforeTargets="_ResolveSdks;PrepareForBuild"
			Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
		<Error Condition="'$(FLARE_ANDROID_KEYSTORE)' == '' or '$(FLARE_ANDROID_KEY_ALIAS)' == '' or '$(FLARE_ANDROID_KEYSTORE_PASSWORD)' == '' or '$(FLARE_ANDROID_KEY_PASSWORD)' == ''"
			   Text="Flare Android Release signing requires all of FLARE_ANDROID_KEYSTORE, FLARE_ANDROID_KEY_ALIAS, FLARE_ANDROID_KEYSTORE_PASSWORD, and FLARE_ANDROID_KEY_PASSWORD. One or more values are missing." />
		<Error Condition="'$(FLARE_ANDROID_KEYSTORE)' != '' and !Exists('$(FLARE_ANDROID_KEYSTORE)')"
			   Text="Flare Android Release keystore was not found at '$(FLARE_ANDROID_KEYSTORE)'." />
	</Target>

	<Target Name="CreateVersionedFlareAndroidApk"
			AfterTargets="_Sign"
			Condition="'$(Configuration)' == 'Release' and '$(AndroidPackageFormat)' == 'apk'">
		<PropertyGroup>
			<_FlareVersionedApk>$(OutDir)$(FlareAndroidApkFileName)</_FlareVersionedApk>
		</PropertyGroup>
		<Error Condition="!Exists('$(ApkFileSigned)')"
			   Text="The signed Flare APK was not found at '$(ApkFileSigned)'." />
		<Copy SourceFiles="$(ApkFileSigned)" DestinationFiles="$(_FlareVersionedApk)" />
		<ItemGroup>
			<FileWrites Include="$(_FlareVersionedApk)" />
		</ItemGroup>
		<Message Importance="high" Text="Versioned Flare APK: $(_FlareVersionedApk)" />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#08090A" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#08090A" BaseSize="192,192" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*.svg" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Flare.Contracts\Flare.Contracts.csproj" />
	</ItemGroup>

</Project>
