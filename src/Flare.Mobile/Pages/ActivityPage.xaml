<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             xmlns:contracts="clr-namespace:Flare.Contracts;assembly=Flare.Contracts"
             x:Class="Flare.Mobile.Pages.ActivityPage"
             x:DataType="pages:ActivityPage" SafeAreaEdges="Container" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid>
    <Grid RowDefinitions="Auto,*" Padding="20,22,20,82" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="EVENT STREAM" Style="{StaticResource Eyebrow}"/><Label Text="Activity" Style="{StaticResource PageTitle}"/></VerticalStackLayout><controls:FlareGlassButton Grid.Column="1" Text="ME" FontSize="11" WidthRequest="44" SemanticProperties.Description="Open settings" Clicked="SettingsClicked" /></Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Events}">
                    <CollectionView.EmptyView><Label Text="No recent activity." Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="contracts:ActivityEventResponse">
                        <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,1" Padding="0,13,0,0" RowSpacing="3">
                            <Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding Result, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,6,0,0" />
                            <Label Grid.Column="1" Text="{Binding Action}" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource Timestamp}}" Style="{StaticResource Secondary}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8"><Label Text="{Binding Target}" Style="{StaticResource Secondary}"/><Label Text="{Binding Kind, StringFormat='· {0}'}" Style="{StaticResource Secondary}"/><Label Text="{Binding Actor, StringFormat='· {0}'}" Style="{StaticResource Secondary}"/></HorizontalStackLayout>
                            <BoxView Grid.Row="2" Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource Border}" Margin="0,12,0,0" />
                        </Grid>
                    </DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </RefreshView>
    </Grid>
    <controls:FlareGlassNavigationBar SelectedRoute="activity" Margin="14,0,14,12" VerticalOptions="End" />
    </Grid>
</pages:BindablePage>
