<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Flare.Mobile.Pages.StartupPage"
             SafeAreaEdges="All"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="32">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <Image Source="flare_mark.svg" WidthRequest="72" HeightRequest="72" />
            <Label Text="FLARE" FontSize="28" FontAttributes="Bold" CharacterSpacing="4" HorizontalTextAlignment="Center" />
            <Label Text="HOMELAB CONTROL" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
