<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             x:Class="Flare.Mobile.Pages.SettingsPage"
             x:DataType="pages:SettingsPage" SafeAreaEdges="Container" Shell.NavBarIsVisible="True" Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,32" Spacing="0">
            <Label Text="FLARE" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Accent}" />
            <Label Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />

            <Label Text="ACCOUNT" Style="{StaticResource Eyebrow}" />
            <Grid ColumnDefinitions="*,Auto" Padding="0,12"><VerticalStackLayout><Label Text="{Binding Email}" FontAttributes="Bold"/><Label Text="Administrator session" Style="{StaticResource Secondary}"/></VerticalStackLayout><controls:FlareGlassButton Grid.Column="1" Text="Logout" IsDestructive="True" Clicked="LogoutClicked" /></Grid>
            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

            <Label Text="SERVER" Style="{StaticResource Eyebrow}" Margin="0,22,0,0" />
            <Grid ColumnDefinitions="*,Auto" Padding="0,12"><VerticalStackLayout><Label Text="{Binding ServerUrl}" LineBreakMode="TailTruncation"/><Label Text="{Binding Connectivity}" Style="{StaticResource Secondary}"/></VerticalStackLayout><controls:FlareGlassButton Grid.Column="1" Text="Reconnect" Clicked="ReconnectClicked" /></Grid>
            <controls:FlareGlassButton Text="Change server" Clicked="ChangeServerClicked" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" Margin="0,8" />
            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,18,0,0" />

            <Label Text="APPEARANCE" Style="{StaticResource Eyebrow}" Margin="0,22,0,8" />
            <Grid ColumnDefinitions="*,140"><VerticalStackLayout><Label Text="Theme"/><Label Text="Dark is recommended for infrastructure monitoring." Style="{StaticResource Secondary}"/></VerticalStackLayout><Picker x:Name="ThemePicker" Grid.Column="1" SelectedIndexChanged="ThemeChanged"><Picker.Items><x:String>Dark</x:String><x:String>System</x:String></Picker.Items></Picker></Grid>
            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,18,0,0" />

            <Label Text="ABOUT" Style="{StaticResource Eyebrow}" Margin="0,22,0,12" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Label Text="Mobile version" Style="{StaticResource Secondary}"/><Label Grid.Column="1" Text="{Binding MobileVersion}"/>
                <Label Grid.Row="1" Text="API version" Style="{StaticResource Secondary}"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding ApiVersion}"/>
                <Label Grid.Row="2" Text="Server version" Style="{StaticResource Secondary}"/><Label Grid.Row="2" Grid.Column="1" Text="{Binding ServerVersion}"/>
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,18" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BindablePage>
