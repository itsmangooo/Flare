<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:contracts="clr-namespace:Flare.Contracts;assembly=Flare.Contracts"
             x:Class="Flare.Mobile.Pages.ContainersPage"
             x:DataType="pages:ContainersPage"
             SafeAreaEdges="All"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20,22,20,0" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2"><Label Text="INFRASTRUCTURE" Style="{StaticResource Eyebrow}" /><Label Text="Containers" Style="{StaticResource PageTitle}" /></VerticalStackLayout>
            <Button Grid.Column="1" Text="ME" FontSize="11" Style="{StaticResource QuietButton}" WidthRequest="44" SemanticProperties.Description="Open settings" Clicked="SettingsClicked" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,120" ColumnSpacing="8">
            <SearchBar Placeholder="Search containers" TextChanged="SearchChanged" />
            <Picker x:Name="FilterPicker" Grid.Column="1" SelectedIndex="0" SelectedIndexChanged="FilterChanged">
                <Picker.Items><x:String>All</x:String><x:String>Running</x:String><x:String>Stopped</x:String><x:String>Unhealthy</x:String></Picker.Items>
            </Picker>
        </Grid>
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Containers}" SelectionMode="Single" SelectionChanged="ContainerSelected">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8"><Label Text="No containers" HorizontalTextAlignment="Center" FontAttributes="Bold" /><Label Text="Docker returned no matching containers." Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:ContainerSummaryResponse">
                            <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,Auto,1" Padding="0,13,0,0" RowSpacing="3">
                                <Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding State, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,6,0,0" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                <Label Grid.Column="2" Text="{Binding CpuPercent, Converter={StaticResource Percent}}" Style="{StaticResource Secondary}" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Image}" Style="{StaticResource Secondary}" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                                    <Label Text="{Binding State}" Style="{StaticResource Secondary}" />
                                    <Label Text="·" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding Health}" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding StartedAt, Converter={StaticResource UptimeSince}}" Style="{StaticResource Secondary}" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding MemoryBytes, Converter={StaticResource Bytes}}" Style="{StaticResource Secondary}" />
                                <BoxView Grid.Row="3" Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource Border}" Margin="0,12,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </RefreshView>
    </Grid>
</pages:BindablePage>
