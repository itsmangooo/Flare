<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             x:Class="Flare.Mobile.Pages.DeploymentDetailPage"
             x:DataType="pages:DeploymentDetailPage" SafeAreaEdges="Container" Shell.NavBarIsVisible="True" Title="Deployment">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,32" Spacing="0">
            <Label Text="DEPLOYMENT" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding Deployment.ResourceName}" Style="{StaticResource PageTitle}" />
            <HorizontalStackLayout Spacing="7" Margin="0,4,0,20"><Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding Deployment.Status, Converter={StaticResource StatusColor}}"/><Label Text="{Binding Deployment.Status}" /></HorizontalStackLayout>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                <VerticalStackLayout><Label Text="BRANCH" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.Branch}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"><Label Text="COMMIT" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.Commit}" LineBreakMode="TailTruncation" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1"><Label Text="STARTED" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.StartedAt, Converter={StaticResource ExactTimestamp}}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="FINISHED" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.FinishedAt, Converter={StaticResource ExactTimestamp}}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2"><Label Text="DURATION" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.Duration, Converter={StaticResource Duration}}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2"><Label Text="MESSAGE" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Deployment.CommitMessage}" /></VerticalStackLayout>
            </Grid>
            <controls:FlareGlassButton Text="Redeploy" IsPrimary="True" Margin="0,20,0,0" IsEnabled="{Binding CanRedeploy}" Clicked="RedeployClicked" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" Margin="0,10" />
            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,20" />
            <Label Text="DEPLOYMENT LOG" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
            <controls:FlareGlassCard Padding="12" CornerRadius="12" BlurRadius="14" RefractionStrength="4">
                <ScrollView HeightRequest="420" Orientation="Both"><Label Text="{Binding Deployment.Logs}" FontFamily="monospace" FontSize="11" LineBreakMode="NoWrap" /></ScrollView>
            </controls:FlareGlassCard>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,12" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BindablePage>
