<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             x:Class="Flare.Mobile.Pages.ConnectPage"
             x:DataType="pages:ConnectPage"
             SafeAreaEdges="All"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="24,40" RowDefinitions="*,Auto" RowSpacing="24">
        <VerticalStackLayout VerticalOptions="Center" Spacing="10">
            <Image Source="flare_mark.svg" WidthRequest="58" HeightRequest="58" HorizontalOptions="Start" />
            <Label Text="FLARE" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Accent}" />
            <Label Text="Connect to Flare" Style="{StaticResource PageTitle}" />
            <Label Text="Enter the public HTTPS address of your self-hosted Flare API. Infrastructure credentials stay on the server."
                   Style="{StaticResource Secondary}" LineBreakMode="WordWrap" />
            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,14" />
            <Label Text="SERVER URL" Style="{StaticResource Eyebrow}" />
            <controls:FlareGlassTextField x:Name="ServerEntry" Placeholder="https://flare.example.com" Keyboard="Url" ReturnType="Go" Completed="ConnectClicked" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" />
            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding ConnectionState}" TextColor="{Binding ConnectionState, Converter={StaticResource StatusColor}}" Style="{StaticResource Secondary}" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <controls:FlareGlassButton Grid.Row="1" Text="Connect" IsPrimary="True" Clicked="ConnectClicked" IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</pages:BindablePage>
