<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             xmlns:contracts="clr-namespace:Flare.Contracts;assembly=Flare.Contracts"
             x:Class="Flare.Mobile.Pages.DeploymentsPage"
             x:DataType="pages:DeploymentsPage"
             SafeAreaEdges="Container"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid>
    <Grid RowDefinitions="Auto,*" Padding="20,22,20,82" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2"><Label Text="COOLIFY" Style="{StaticResource Eyebrow}" /><Label Text="Deployments" Style="{StaticResource PageTitle}" /></VerticalStackLayout>
            <controls:FlareGlassButton Grid.Column="1" Text="Resources" Clicked="ResourcesClicked" />
            <controls:FlareGlassButton Grid.Column="2" Text="ME" FontSize="11" WidthRequest="44" SemanticProperties.Description="Open settings" Clicked="SettingsClicked" />
        </Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Deployments}" SelectionMode="Single" SelectionChanged="DeploymentSelected">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8"><Label Text="No deployments" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="Coolify returned no deployment history." Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:DeploymentResponse">
                            <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,Auto,1" Padding="0,14,0,0" RowSpacing="3">
                                <Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding Status, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,6,0,0" />
                                <Label Grid.Column="1" Text="{Binding ResourceName}" FontAttributes="Bold" FontSize="15" />
                                <Label Grid.Column="2" Text="{Binding StartedAt, Converter={StaticResource Timestamp}}" Style="{StaticResource Secondary}" />
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                    <Label Text="{Binding Status}" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding Branch, StringFormat='· {0}'}" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding Commit, StringFormat='· {0}'}" Style="{StaticResource Secondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding CommitMessage}" Style="{StaticResource Secondary}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding Duration, Converter={StaticResource Duration}}" Style="{StaticResource Secondary}" />
                                <BoxView Grid.Row="3" Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource Border}" Margin="0,13,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </RefreshView>
    </Grid>
    <controls:FlareGlassNavigationBar SelectedRoute="deployments" Margin="14,0,14,12" VerticalOptions="End" />
    </Grid>
</pages:BindablePage>
