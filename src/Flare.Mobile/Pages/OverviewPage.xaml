<?xml version="1.0" encoding="UTF-8" ?>
<pages:BindablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Flare.Mobile.Pages"
             xmlns:controls="clr-namespace:Flare.Mobile.Controls"
             xmlns:contracts="clr-namespace:Flare.Contracts;assembly=Flare.Contracts"
             x:Class="Flare.Mobile.Pages.OverviewPage"
             x:DataType="pages:OverviewPage"
             SafeAreaEdges="Container"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,22,20,108" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="FLARE" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Accent}" />
                        <Label Text="Overview" Style="{StaticResource PageTitle}" />
                    </VerticalStackLayout>
                    <controls:FlareGlassButton Grid.Column="1" Text="ME" FontSize="11" WidthRequest="44" SemanticProperties.Description="Open settings" Clicked="SettingsClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding HostName}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Uptime, StringFormat='Up {0}'}" Style="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                    <controls:FlareStatusPill Grid.Column="1" Text="{Binding Freshness}" StatusColor="{Binding Freshness, Converter={StaticResource StatusColor}}" VerticalOptions="Center" />
                </Grid>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" Margin="0,0,0,12" />

                <controls:FlareGlassCard>
                <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                    <Label Text="CPU" Style="{StaticResource Eyebrow}" />
                    <Label Grid.Column="1" Text="{Binding CpuPercent, Converter={StaticResource Percent}}" FontAttributes="Bold" />
                    <controls:MetricBarView Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding CpuPercent}" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                        <controls:SparklineView Points="{Binding History}" Metric="cpu" />
                        <Label Grid.Column="1" Text="{Binding LoadAverage, StringFormat='Load {0:0.00}'}" Style="{StaticResource Secondary}" VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,18" />

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Label Text="MEMORY" Style="{StaticResource Eyebrow}" />
                    <Label Grid.Column="1" Text="{Binding MemoryPercent, Converter={StaticResource Percent}}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="{Binding MemoryLine}" Style="{StaticResource Secondary}" />
                    <controls:MetricBarView Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding MemoryPercent}" />
                    <controls:SparklineView Grid.Row="3" Grid.ColumnSpan="2" Points="{Binding History}" Metric="memory" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,18" />

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Label Text="DISK" Style="{StaticResource Eyebrow}" />
                    <Label Grid.Column="1" Text="{Binding DiskPercent, Converter={StaticResource Percent}}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="{Binding DiskLine}" Style="{StaticResource Secondary}" />
                    <controls:MetricBarView Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding DiskPercent}" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,18" />

                <Label Text="NETWORK" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="DOWNLOAD" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding NetworkReceive, Converter={StaticResource Bytes}, ConverterParameter=rate}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="UPLOAD" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding NetworkTransmit, Converter={StaticResource Bytes}, ConverterParameter=rate}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
                </VerticalStackLayout>
                </controls:FlareGlassCard>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,22" />

                <Label Text="CONTAINERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout><Label Text="{Binding Running}" Style="{StaticResource MetricValue}" /><Label Text="Running" Style="{StaticResource Secondary}" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1"><Label Text="{Binding Stopped}" Style="{StaticResource MetricValue}" /><Label Text="Stopped" Style="{StaticResource Secondary}" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2"><Label Text="{Binding Unhealthy}" Style="{StaticResource MetricValue}" TextColor="{StaticResource Danger}" /><Label Text="Unhealthy" Style="{StaticResource Secondary}" /></VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,22" />
                <Label Text="RECENT ACTIVITY" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="contracts:ActivityEventResponse">
                            <Grid ColumnDefinitions="8,*,Auto" Padding="0,10">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding Result, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,5,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Action}" FontAttributes="Bold" />
                                    <Label Text="{Binding Target}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource Timestamp}}" Style="{StaticResource Secondary}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    <controls:FlareGlassNavigationBar SelectedRoute="overview" Margin="14,0,14,12" VerticalOptions="End" />
    </Grid>
</pages:BindablePage>
