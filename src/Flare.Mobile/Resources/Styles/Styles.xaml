<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage">
        <Setter Property="Background" Value="{StaticResource AppBackground}" />
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Background}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Secondary" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="MetricValue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeMetric}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="#090909" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>
    <Style TargetType="RefreshView"><Setter Property="RefreshColor" Value="{StaticResource Accent}" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{StaticResource Accent}" /></Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    </Style>
</ResourceDictionary>
