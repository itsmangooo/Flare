<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:formatters="clr-namespace:Flare.Mobile.Converters"
             x:Class="Flare.Mobile.App"
             UserAppTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <formatters:PercentConverter x:Key="Percent" />
            <formatters:BytesConverter x:Key="Bytes" />
            <formatters:DurationConverter x:Key="Duration" />
            <formatters:StatusColorConverter x:Key="StatusColor" />
            <formatters:TimestampConverter x:Key="Timestamp" />
            <formatters:ExactTimestampConverter x:Key="ExactTimestamp" />
            <formatters:UptimeSinceConverter x:Key="UptimeSince" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
